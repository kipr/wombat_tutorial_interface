{
  "build": { "dockerfile": "../Dockerfile" },
  "forwardPorts": [1313],
  "features": {
      "ghcr.io/cirolosapio/devcontainers-features/alpine-gpg:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["davidanson.vscode-markdownlint"]
